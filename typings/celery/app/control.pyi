from collections.abc import Mapping, Sequence

class Inspect:
    def __init__(self, *, timeout: float = 1.0, **options: object) -> None: ...
    def active(self, safe: bool | None = None) -> Mapping[str, object] | None: ...
    def scheduled(self, safe: bool | None = None) -> Mapping[str, object] | None: ...
    def reserved(self, safe: bool | None = None) -> Mapping[str, object] | None: ...
    def stats(self) -> Mapping[str, object] | None: ...
    def ping(self, destination: str | Sequence[str] | None = None) -> Mapping[str, object] | None: ...
    def registered(self, *taskinfoitems: str) -> Mapping[str, object] | None: ...

class Control:
    def inspect(self, *, timeout: float = 1.0, **options: object) -> Inspect: ...
    def revoke(
        self,
        task_id: str | Sequence[str],
        destination: str | Sequence[str] | None = None,
        terminate: bool = False,
        signal: str = "TERM",
        **options: object,
    ) -> object: ...
