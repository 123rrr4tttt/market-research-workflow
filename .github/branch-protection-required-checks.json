{
  "branch": "main",
  "required_checks": [
    "backend-tests"
  ],
  "required_check_sources": {
    "backend-tests": ".github/workflows/backend-tests.yml"
  },
  "default_pr_evidence": {
    "template": ".github/PULL_REQUEST_TEMPLATE.md",
    "required_sections": [
      "Scope",
      "Risk",
      "Test Evidence",
      "Rollback Strategy",
      "Docs And Closure"
    ]
  },
  "docs_sync_targets": [
    "development/latest-dev-docs/README.md",
    "development/latest-dev-docs/MERGED_OVERVIEW.md",
    "development/latest-dev-docs/development-plans/INDEX.md",
    "development/latest-dev-docs/development-plans/CURRENT_DEV/INDEX.md"
  ],
  "local_repro_profiles": [
    "unit",
    "integration",
    "contract",
    "ci-pr"
  ],
  "note": "Temporary rxx matrix workflows were retired; backend-tests is the current required check baseline as of 2026-05-07"
}
