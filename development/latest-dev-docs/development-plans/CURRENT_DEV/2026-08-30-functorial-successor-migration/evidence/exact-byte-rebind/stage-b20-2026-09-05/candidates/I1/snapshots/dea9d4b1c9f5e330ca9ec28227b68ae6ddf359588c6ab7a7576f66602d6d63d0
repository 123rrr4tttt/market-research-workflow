def _assert_direct_annotated_return(function_name: str, derived_as: str, fact_source: str, witness: str) -> None:
    source = SCRIPT.read_text(encoding="utf-8")
    tree = ast.parse(source, filename=SCRIPT.as_posix())
    function = next(
        node
        for node in tree.body
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == function_name
    )
    assert isinstance(function.returns, ast.Subscript)
    assert isinstance(function.returns.value, ast.Name)
    assert function.returns.value.id == "Annotated"

    return_hint = get_type_hints(GENERATOR.build_documents, include_extras=True)["return"]
    assert get_origin(return_hint) is Annotated
    _, annotation = get_args(return_hint)
    tokens = shlex.split(annotation)
    assert tokens[0] == "kit:non-authoritative"
    fields = dict(token.split("=", 1) for token in tokens[1:])
    assert fields == {
        "derived_as": derived_as,
        "fact_source": fact_source,
        "witness": witness,
    }


def test_generate_stage0_i1_documents_metadata() -> None:
    _assert_direct_annotated_return(
        "build_documents",
        "generated_evidence",
        "base_I1_generator_frozen_predecessors_current_specs_builds_bindings",
        "test:test_generate_stage0_i1_documents_metadata",
    )


def _sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def test_b13_dry_run_is_deterministic_and_binds_current_shas() -> None:
    first = GENERATOR._build_documents(ROOT, "B13")
    second = GENERATOR._build_documents(ROOT, "stage-b13-2026-09-05")
    assert first == second

    fragment_rel = GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05/fragments/I1.json"
    manifest_rel = GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05/manifests/I1.json"
    fragment = json.loads(first[fragment_rel])
    manifest = json.loads(first[manifest_rel])
    assert fragment["schema"] == GENERATOR.FRAGMENT_SCHEMA
    assert fragment["amendment"] == GENERATOR.AMENDMENT
    assert fragment["bindings"]
    assert len(fragment["bindings"]) >= 37
    assert manifest["fragments"][0]["file_sha256"] == _sha_bytes(first[fragment_rel])

    source_paths = {item["path"] for item in manifest["sources"]}
    assert GENERATOR.BASE_GENERATOR_REL.as_posix() in source_paths
    assert len(source_paths) >= 60
    for item in manifest["sources"] + manifest["tests"]:
        path = ROOT / item["path"]
        assert path.is_file()
        assert item["file_sha256"] == _sha(path)


