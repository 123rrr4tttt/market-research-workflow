def test_b17_builds_additive_documents_in_tmp_path(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    fragment_rel = GENERATOR.EXACT_REBIND_REL / "stage-b17-2099-01-01/fragments/I1.json"
    manifest_rel = GENERATOR.EXACT_REBIND_REL / "stage-b17-2099-01-01/manifests/I1.json"
    fragment = {
        "schema": GENERATOR.FRAGMENT_SCHEMA,
        "bindings": [],
        "content_digest": "0" * 64,
    }
    fragment_payload = GENERATOR._canonical_json(fragment) + b"\n"

    monkeypatch.setattr(GENERATOR, "_guard_predecessors", lambda root, stage: None)
    monkeypatch.setattr(
        GENERATOR,
        "_collect_binding_paths",
        lambda root, stage: {"shared.py"},
    )
    monkeypatch.setattr(
        GENERATOR,
        "_documents",
        lambda root, stage_rel, amendment: {
            stage_rel / GENERATOR.FRAGMENT_NAME: fragment_payload,
            stage_rel / GENERATOR.MANIFEST_NAME: b"{}\n",
        },
    )
    monkeypatch.setattr(
        GENERATOR,
        "_raw_ref",
        lambda root, relative: {"path": Path(relative).as_posix(), "file_sha256": "0" * 64},
    )

    documents = GENERATOR._build_documents(tmp_path, "stage-b17-2099-01-01")
    assert set(documents) == {fragment_rel, manifest_rel}
    assert json.loads(documents[manifest_rel])["amendment"] == GENERATOR.B17_AMENDMENT
    assert not (tmp_path / fragment_rel).exists()


