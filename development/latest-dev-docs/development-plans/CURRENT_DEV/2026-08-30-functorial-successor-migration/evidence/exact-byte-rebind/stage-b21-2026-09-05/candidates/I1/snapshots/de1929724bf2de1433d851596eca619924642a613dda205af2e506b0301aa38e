class GenerationError(RuntimeError):
    """A required immutable or live input cannot be established."""


def _sha256(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def _canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=True,
        sort_keys=True,
        separators=(",", ":"),
        allow_nan=False,
    ).encode("utf-8")


def _load_base_generator(root: Path):
    path = _require_file(root, BASE_GENERATOR_REL)
    spec = importlib.util.spec_from_file_location("_stage0_i1_base_generator", path)
    if spec is None or spec.loader is None:
        raise GenerationError(f"cannot load base I1 generator: {path}")  # noqa: TRY003
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _safe_relative(root: Path, relative: Path | str) -> Path:
    candidate = Path(relative)
    if (
        candidate.is_absolute()
        or "\\" in str(relative)
        or not candidate.parts
        or any(part in {"", ".", ".."} for part in candidate.parts)
    ):
        raise GenerationError(f"path escapes repository root: {relative}")  # noqa: TRY003
    resolved = (root / candidate).resolve()
    try:
        resolved.relative_to(root.resolve())
    except ValueError as exc:
        raise GenerationError(f"path escapes repository root: {relative}") from exc  # noqa: TRY003
    return candidate


def _require_file(root: Path, relative: Path | str) -> Path:
    safe = _safe_relative(root, relative)
    path = root / safe
    if not path.is_file() or path.is_symlink():
        raise GenerationError(f"required input missing: {safe.as_posix()}")  # noqa: TRY003
    return path


def _raw_ref(root: Path, relative: Path | str) -> dict[str, str]:
    safe = _safe_relative(root, relative)
    payload = _require_file(root, safe).read_bytes()
    return {"path": safe.as_posix(), "file_sha256": _sha256(payload)}


def _validate_stage(stage: str) -> str:
    if stage == "B13":
        return DEFAULT_STAGE
    if stage == "B14":
        return DEFAULT_B14_STAGE
    if stage == "B15":
        return DEFAULT_B15_STAGE
    if stage == "B16":
        return DEFAULT_B16_STAGE
    if stage == "B17":
        return DEFAULT_B17_STAGE
    if stage == "B18":
        return DEFAULT_B18_STAGE
    if stage == "B19":
        return DEFAULT_B19_STAGE
    if stage == "B20":
        return DEFAULT_B20_STAGE
    if stage == "B21":
        return DEFAULT_B21_STAGE
    if not re.fullmatch(r"stage-b1[3-9]-\d{4}-\d{2}-\d{2}|stage-b2[01]-\d{4}-\d{2}-\d{2}", stage):
        raise GenerationError(  # noqa: TRY003
            "invalid stage; expected B13/B14/B15/B16/B17/B18/B19/B20/B21 or stage-b1[3-9]/stage-b2[01]-YYYY-MM-DD"
        )
    try:
        datetime.date.fromisoformat(re.sub(r"^stage-(?:b1[3-9]|b2[01])-", "", stage))
    except ValueError as exc:
        raise GenerationError(  # noqa: TRY003
            "invalid stage; expected B13/B14/B15/B16/B17/B18/B19/B20/B21 or stage-b1[3-9]/stage-b2[01]-YYYY-MM-DD"
        ) from exc
    return stage


validate_stage = _validate_stage


def _predecessor_hashes(stage: str | None = None) -> dict[Path, str]:
    stage_name = _validate_stage(stage) if stage is not None else DEFAULT_STAGE
    if stage_name.startswith("stage-b16-"):
        return {
            **PREDECESSOR_HASHES,
            **B13_PREDECESSOR_HASHES,
            **B14_PREDECESSOR_HASHES,
            **B15_PREDECESSOR_HASHES,
        }
    if stage_name.startswith(("stage-b17-", "stage-b18-")):
        return {
            **PREDECESSOR_HASHES,
            **B13_PREDECESSOR_HASHES,
            **B14_PREDECESSOR_HASHES,
            **B15_PREDECESSOR_HASHES,
            **B16_PREDECESSOR_HASHES,
        }
    if stage_name.startswith("stage-b19-"):
        return dict(B19_PREDECESSOR_HASHES)
    if stage_name.startswith("stage-b20-"):
        return dict(B20_PREDECESSOR_HASHES)
    if stage_name.startswith("stage-b21-"):
        return dict(B21_PREDECESSOR_HASHES)
    if stage_name.startswith("stage-b15-"):
        return {**PREDECESSOR_HASHES, **B13_PREDECESSOR_HASHES, **B14_PREDECESSOR_HASHES}
    if stage_name.startswith("stage-b14-"):
        return {**PREDECESSOR_HASHES, **B13_PREDECESSOR_HASHES}
    return dict(PREDECESSOR_HASHES)


def _guard_predecessors(root: Path, stage: str | None = None) -> None:
    for relative, expected in _predecessor_hashes(stage).items():
        actual = _sha256(_require_file(root, relative).read_bytes())
        if actual != expected:
            raise GenerationError(  # noqa: TRY003
                f"frozen predecessor drift: {relative.as_posix()} expected={expected} actual={actual}"
            )


def _guard_binding_path(root: Path, relative: str) -> None:
    safe = _safe_relative(root, relative)
    resolved = (root / safe).resolve()
    for frozen in (SPECS_REL, BUILDS_REL):
        frozen_path = (root / frozen).resolve()
        try:
            resolved.relative_to(frozen_path)
        except ValueError:
            continue
        raise GenerationError(f"frozen binding path is not writable: {relative}")  # noqa: TRY003
    _require_file(root, safe)


def _packet_source_binding_paths(root: Path) -> set[str]:
    payload_path = _require_file(root, P2_C21_PACKET_REL)
    try:
        packet = json.loads(payload_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise GenerationError(f"invalid P2 C2.1 packet: {exc}") from exc  # noqa: TRY003
    if not isinstance(packet, dict) or not isinstance(packet.get("source_bindings"), list):
        raise GenerationError("P2 C2.1 packet source_bindings are invalid")  # noqa: TRY003
    paths: set[str] = set()
    for binding in packet["source_bindings"]:
        if not isinstance(binding, dict) or not isinstance(binding.get("path"), str):
            raise GenerationError("P2 C2.1 packet contains an invalid source binding")  # noqa: TRY003
        _guard_binding_path(root, binding["path"])
        paths.add(_safe_relative(root, binding["path"]).as_posix())
    return paths


def _collect_binding_paths(root: Path, stage: str | None = None) -> set[str]:
    try:
        specs = sorted((root / SPECS_REL).glob("C*.v1.json"))
    except OSError as exc:
        raise GenerationError(f"cannot scan frozen specs: {exc}") from exc  # noqa: TRY003
    if len(specs) != 30:
        raise GenerationError(f"expected 30 frozen capability specs, found {len(specs)}")  # noqa: TRY003
    builds = sorted((root / BUILDS_REL).glob("*.BuildManifest.v1.json"))
    if len(builds) != 30:
        raise GenerationError(f"expected 30 frozen build manifests, found {len(builds)}")  # noqa: TRY003
    paths: set[str] = set()
    for spec_path in specs:
        try:
            payload = json.loads(spec_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise GenerationError(f"invalid frozen spec {spec_path}: {exc}") from exc  # noqa: TRY003
        if not isinstance(payload, dict):
            raise GenerationError(f"frozen spec must be an object: {spec_path}")  # noqa: TRY003
        for group in ("source_bindings", "test_bindings", "rollback_bindings"):
            values = payload.get(group, ())
            if not isinstance(values, list):
                raise GenerationError(f"invalid {group} in frozen spec: {spec_path}")  # noqa: TRY003
            for binding in values:
                if not isinstance(binding, dict) or not isinstance(binding.get("path"), str):
                    raise GenerationError(f"invalid binding in frozen spec: {spec_path}")  # noqa: TRY003
                _guard_binding_path(root, binding["path"])
                paths.add(_safe_relative(root, binding["path"]).as_posix())
    if _validate_stage(stage).startswith(
        ("stage-b17-", "stage-b18-", "stage-b19-", "stage-b20-", "stage-b21-")
    ):
        paths.update(EXACT_PROTOCOL_PATHS)
        if P2_C21_PACKET_REL.as_posix() in paths:
            paths.update(_packet_source_binding_paths(root))
    return paths


def _documents(root: Path, stage_rel: Path, amendment: str = AMENDMENT) -> dict[Path, bytes]:
    """Delegate byte construction to the predecessor generator under B13 names."""

    base = _load_base_generator(root)
    original = {
        "STAGE_REL": base.STAGE_REL,
        "FRAGMENT_REL": base.FRAGMENT_REL,
        "MANIFEST_REL": base.MANIFEST_REL,
        "AMENDMENT": base.AMENDMENT,
    }
    fragment_rel = stage_rel / FRAGMENT_NAME
    manifest_rel = stage_rel / MANIFEST_NAME
    base.STAGE_REL = stage_rel
    base.FRAGMENT_REL = fragment_rel
    base.MANIFEST_REL = manifest_rel
    base.AMENDMENT = amendment
    try:
        return base._documents(root)
    finally:
        for name, value in original.items():
            setattr(base, name, value)


def _build_documents(root: Path, stage: str) -> dict[Path, bytes]:
    stage_name = _validate_stage(stage)
    stage_rel = EXACT_REBIND_REL / stage_name
    amendment = (
        B16_AMENDMENT
        if stage_name.startswith("stage-b16-")
        else B19_AMENDMENT
        if stage_name.startswith("stage-b19-")
        else B20_AMENDMENT
        if stage_name.startswith("stage-b20-")
        else B21_AMENDMENT
        if stage_name.startswith("stage-b21-")
        else B18_AMENDMENT
        if stage_name.startswith("stage-b18-")
        else B17_AMENDMENT
        if stage_name.startswith("stage-b17-")
        else B15_AMENDMENT
        if stage_name.startswith("stage-b15-")
        else B14_AMENDMENT
        if stage_name.startswith("stage-b14-")
        else AMENDMENT
    )
    fragment_rel = stage_rel / FRAGMENT_NAME
    manifest_rel = stage_rel / MANIFEST_NAME
    _safe_relative(root, fragment_rel)
    _safe_relative(root, manifest_rel)
    _guard_predecessors(root, stage_name)
    binding_paths = _collect_binding_paths(root, stage_name)

    documents = _documents(root, stage_rel, amendment)

    fragment_payload = documents[fragment_rel]
    fragment = json.loads(fragment_payload.decode("utf-8"))
    if fragment.get("schema") != FRAGMENT_SCHEMA:
        raise GenerationError("base generator produced an unexpected I1 fragment schema")  # noqa: TRY003
    for item in fragment.get("bindings", ()):
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            raise GenerationError("generated fragment contains an invalid binding")  # noqa: TRY003
        path = Path(item["path"])
        if path.is_absolute() or ".." in path.parts:
            raise GenerationError("generated fragment contains a path escape")  # noqa: TRY003
        group = item.get("binding_group")
        if group != "rollback_bindings" and {"p3-fragments", "p4-fragments"} & set(path.parts):
            raise GenerationError("generated fragment targets a frozen P3/P4 path")  # noqa: TRY003

    source_paths = set(binding_paths)
    source_paths.update(relative.as_posix() for relative in _predecessor_hashes(stage_name))
    source_paths.add(BASE_GENERATOR_REL.as_posix())
    source_paths.add(STAGE0_GENERATOR_REL.as_posix())
    source_paths.add("main/backend/app/successor_runtime/specification/capability_cell_spec.py")
    source_paths.add("main/backend/app/successor_runtime/specification/runtime_kernel_abi.py")
    source_paths.add("main/backend/app/successor_runtime/specification/compiler.py")
    source_paths.add((SPECS_REL / "RuntimeKernelABI.v1.json").as_posix())
    for spec_path in sorted((root / SPECS_REL).glob("C*.v1.json")):
        source_paths.add(_safe_relative(root, spec_path.relative_to(root)).as_posix())
    for spec_path in sorted((root / BUILDS_REL).glob("*.BuildManifest.v1.json")):
        source_paths.add(_safe_relative(root, spec_path.relative_to(root)).as_posix())

    manifest = {
        "amendment": amendment,
        "family": "I1",
        "fragments": [
            {
                "content_digest": fragment["content_digest"],
                "file_sha256": _sha256(fragment_payload),
                "path": fragment_rel.as_posix(),
            }
        ],
        "schema": MANIFEST_SCHEMA,
        "sources": [_raw_ref(root, path) for path in sorted(source_paths)],
        "tests": [_raw_ref(root, path) for path in WITNESS_TESTS],
    }
    return {
        fragment_rel: fragment_payload,
        manifest_rel: _canonical_json(manifest) + b"\n",
    }


def build_documents(repo_root: Path, stage: str) -> Annotated[
    dict[Path, bytes],
