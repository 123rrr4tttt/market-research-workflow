from __future__ import annotations

import hashlib
import importlib.util
import json
from pathlib import Path

import pytest


ROOT = Path(__file__).resolve().parents[2]
SCRIPT = ROOT / "scripts/generate_stage0_i1_exact_binding_rebind.py"
SPEC = importlib.util.spec_from_file_location("stage0_i1_generator", SCRIPT)
assert SPEC is not None and SPEC.loader is not None
GENERATOR = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(GENERATOR)


def _sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def test_b13_dry_run_is_deterministic_and_binds_current_shas() -> None:
    first = GENERATOR._build_documents(ROOT, "B13")
    second = GENERATOR._build_documents(ROOT, "stage-b13-2026-09-05")
    assert first == second

    fragment_rel = GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05/fragments/I1.json"
    manifest_rel = GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05/manifests/I1.json"
    fragment = json.loads(first[fragment_rel])
    manifest = json.loads(first[manifest_rel])
    assert fragment["schema"] == GENERATOR.FRAGMENT_SCHEMA
    assert fragment["amendment"] == GENERATOR.AMENDMENT
    assert fragment["bindings"]
    assert len(fragment["bindings"]) >= 37
    assert manifest["fragments"][0]["file_sha256"] == _sha_bytes(first[fragment_rel])

    source_paths = {item["path"] for item in manifest["sources"]}
    assert GENERATOR.BASE_GENERATOR_REL.as_posix() in source_paths
    assert len(source_paths) >= 60
    for item in manifest["sources"] + manifest["tests"]:
        path = ROOT / item["path"]
        assert path.is_file()
        assert item["file_sha256"] == _sha(path)


def _sha_bytes(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


@pytest.mark.parametrize(
    "stage",
    [
        "B12",
        "B14",
        "13",
        "stage-b13",
        "stage-b12-2026-09-05",
        "stage-b13-2026-02-30",
        "../B13",
    ],
)
def test_invalid_stage_is_rejected(stage: str) -> None:
    with pytest.raises(GENERATOR.GenerationError, match="invalid stage"):
        GENERATOR._validate_stage(stage)


def test_frozen_and_escaping_binding_paths_are_rejected() -> None:
    frozen = (GENERATOR.SPECS_REL / "C1.1.v1.json").as_posix()
    with pytest.raises(GENERATOR.GenerationError, match="frozen binding path"):
        GENERATOR._guard_binding_path(ROOT, frozen)
    with pytest.raises(GENERATOR.GenerationError, match="escapes repository root"):
        GENERATOR._guard_binding_path(ROOT, "../outside.py")


def test_b9_b10_predecessor_hash_drift_is_rejected(monkeypatch: pytest.MonkeyPatch) -> None:
    predecessor = next(iter(GENERATOR.PREDECESSOR_HASHES))
    monkeypatch.setitem(GENERATOR.PREDECESSOR_HASHES, predecessor, "0" * 64)
    with pytest.raises(GENERATOR.GenerationError, match="frozen predecessor drift"):
        GENERATOR._guard_predecessors(ROOT)


def test_existing_own_target_is_create_only(tmp_path: Path) -> None:
    documents = {
        GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05/fragments/I1.json": b"{}",
        GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05/manifests/I1.json": b"{}",
    }
    stage_dir = tmp_path / GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05"
    stage_dir.mkdir(parents=True)
    (stage_dir / "fragments/I1.json").parent.mkdir(parents=True, exist_ok=True)
    (stage_dir / "fragments/I1.json").write_bytes(b"existing")
    with pytest.raises(GENERATOR.GenerationError, match="refusing to overwrite existing target"):
        GENERATOR._guard_create_only(tmp_path, documents)


def test_existing_stage_allows_i1_coexistence_and_preserves_other_family(tmp_path: Path) -> None:
    stage_dir = tmp_path / GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05"
    stage_dir.mkdir(parents=True)
    other = stage_dir / "fragments/C2.json"
    other.parent.mkdir(parents=True, exist_ok=True)
    other.write_bytes(b"C2-family")
    documents = {
        GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05/fragments/I1.json": b"I1-fragment",
        GENERATOR.EXACT_REBIND_REL / "stage-b13-2026-09-05/manifests/I1.json": b"I1-manifest",
    }
    GENERATOR._write_documents(tmp_path, documents, "B13")
    assert other.read_bytes() == b"C2-family"
    assert (stage_dir / "fragments/I1.json").read_bytes() == b"I1-fragment"
    assert (stage_dir / "manifests/I1.json").read_bytes() == b"I1-manifest"
    with pytest.raises(GENERATOR.GenerationError, match="refusing to overwrite existing target"):
        GENERATOR._guard_create_only(tmp_path, documents)
