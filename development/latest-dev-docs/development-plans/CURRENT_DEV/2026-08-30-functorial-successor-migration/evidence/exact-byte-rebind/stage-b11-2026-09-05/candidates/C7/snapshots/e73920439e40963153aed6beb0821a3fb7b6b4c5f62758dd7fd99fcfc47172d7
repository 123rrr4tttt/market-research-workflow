#!/usr/bin/env python3
"""Generate the additive C7 exact-byte rebind inputs for stage B11.

The P4 fragment and stage B8 candidate remain immutable predecessors.  This
script rebuilds the C7 observation fragment from current implementation bytes,
adds the C7 failure-semantics closure that the predecessor did not bind, and
emits a stage-v2 manifest.  It never writes either predecessor.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import sys
import tempfile
from pathlib import Path
from types import ModuleType
from typing import Any


REPO_ROOT = Path(__file__).resolve().parents[1]
BACKEND_ROOT = REPO_ROOT / "main/backend"
for import_root in (REPO_ROOT / "src", BACKEND_ROOT):
    if str(import_root) not in sys.path:
        sys.path.insert(0, str(import_root))
EVIDENCE_REL = Path(
    "development/latest-dev-docs/development-plans/CURRENT_DEV/"
    "2026-08-30-functorial-successor-migration/evidence"
)
STAGE_REL = EVIDENCE_REL / "exact-byte-rebind/stage-b11-2026-09-05"
FRAGMENT_REL = STAGE_REL / "fragments/C7.json"
MANIFEST_REL = STAGE_REL / "manifests/C7.json"

ORIGINAL_GENERATOR_REL = Path(
    "main/backend/scripts/generate_successor_p4_c7_fragment.py"
)
P4_FRAGMENT_REL = EVIDENCE_REL / "p4-fragments/C7.json"
B8_STAGE_REL = EVIDENCE_REL / "exact-byte-rebind/stage-b8-2026-09-05"
B8_FRAGMENT_REL = B8_STAGE_REL / "fragments/C7.json"
B8_MANIFEST_REL = B8_STAGE_REL / "manifests/C7.json"
B8_CANDIDATE_REL = B8_STAGE_REL / "candidates/C7/candidate.v2.json"

MANIFEST_SCHEMA = "mrw.family_fragment_rebind.stage_manifest.v2"
AMENDMENT = "STAGE_B11_C7_TOTAL_FAILURE_REBIND_CANDIDATE_NOT_AUTHORITY"

FROZEN_PREDECESSORS = {
    P4_FRAGMENT_REL: "d3a7aaf1916d2a01c1ed6e7004a06d6cd6ed24840a7403fd10e2ffdc53559a83",
    B8_FRAGMENT_REL: "d1724ee0a77f6808f6266106c5aea9640e0649c3b29a9527518a14b3af3b30e7",
    B8_MANIFEST_REL: "10d6200d1c2d36523ef71ac3ca3ec255333d714e953405f22294974557bd4321",
    B8_CANDIDATE_REL: "6101a031f6b089ee628af41e993d599dab7170a69d686cb714b8b2d00c01508a",
}

BOUND_IMPLEMENTATIONS = (
    "main/backend/app/successor_runtime/capabilities/ingest_c7_movements.py",
    "main/backend/app/successor_runtime/capabilities/ingest_c7_common.py",
    "main/backend/app/successor_runtime/capabilities/ingest_c7_program.py",
    "main/backend/app/successor_runtime/capabilities/ingest_c7_registry.py",
    "src/mrw_functorial_kit/core/c7_semantics.py",
    "src/mrw_functorial_kit/core/w06_semantics.py",
    "registries/failures.json",
    "main/backend/app/successor_runtime/specification/c7_p4.py",
    "main/backend/app/successor_runtime/specification/shared_family_generator.py",
    ORIGINAL_GENERATOR_REL.as_posix(),
    "scripts/generate_c7_exact_byte_rebind.py",
)

EXTRA_WITNESS_TESTS = (
    "tests/test_c7_runtime_failure_closure.py",
    "tests/test_c7_semantic_registration.py",
    "tests/test_family_fragment_exact_byte_rebind.py",
    "main/backend/tests/successor_runtime/test_p4_c7_1_program.py",
    "main/backend/tests/successor_runtime/test_c7_movement_failure_reverse.py",
    "main/backend/tests/successor_runtime/test_s2b_c7_ingest_registry.py",
)


class GenerationError(RuntimeError):
    """A required immutable or live input cannot be established."""


def _sha256(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def _canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=True,
        sort_keys=True,
        separators=(",", ":"),
        allow_nan=False,
    ).encode("utf-8")


def _content_digest(value: dict[str, Any]) -> str:
    return _sha256(
        _canonical_json({key: item for key, item in value.items() if key != "content_digest"})
    )


def _require_file(root: Path, relative: Path | str) -> Path:
    path = root / relative
    if not path.is_file():
        raise GenerationError(f"required input missing: {relative}")
    return path


def _raw_ref(root: Path, relative: Path | str) -> dict[str, str]:
    relative_path = Path(relative)
    payload = _require_file(root, relative_path).read_bytes()
    return {
        "path": relative_path.as_posix(),
        "file_sha256": _sha256(payload),
    }


def _fragment_binding(root: Path, relative: str, role: str) -> dict[str, object]:
    payload = _require_file(root, relative).read_bytes()
    return {
        "path": relative,
        "sha256": _sha256(payload),
        "bytes": len(payload),
        "lines": len(payload.splitlines()),
        "role": role,
    }


def _load_original_generator(root: Path) -> ModuleType:
    path = _require_file(root, ORIGINAL_GENERATOR_REL)
    spec = importlib.util.spec_from_file_location("_mrw_c7_fragment_generator", path)
    if spec is None or spec.loader is None:
        raise GenerationError(f"cannot load original C7 generator: {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _guard_predecessors(root: Path) -> None:
    for relative, expected in FROZEN_PREDECESSORS.items():
        actual = _sha256(_require_file(root, relative).read_bytes())
        if actual != expected:
            raise GenerationError(
                f"frozen predecessor drift: {relative} expected={expected} actual={actual}"
            )


def _build_fragment(root: Path) -> dict[str, Any]:
    generator = _load_original_generator(root)
    fragment = generator.build_fragment()
    if not isinstance(fragment, dict) or fragment.get("family") != "C7":
        raise GenerationError("original generator did not produce a C7 object")
    authority = fragment.get("authority")
    if not isinstance(authority, dict) or any(authority.values()):
        raise GenerationError("C7 fragment exceeds the all-false authority ceiling")

    bindings = fragment.get("implementation_bindings")
    if not isinstance(bindings, list):
        raise GenerationError("C7 fragment implementation_bindings must be a list")
    by_path = {
        item.get("path"): item
        for item in bindings
        if isinstance(item, dict) and isinstance(item.get("path"), str)
    }
    roles = {
        BOUND_IMPLEMENTATIONS[0]: "c7_total_movement_failure_semantics",
        BOUND_IMPLEMENTATIONS[1]: "c7_total_common_contract_semantics",
        BOUND_IMPLEMENTATIONS[2]: "c7_total_program_binding_semantics",
        BOUND_IMPLEMENTATIONS[3]: "c7_total_registry_failure_semantics",
        BOUND_IMPLEMENTATIONS[4]: "c7_terminal_failure_family_projection",
        BOUND_IMPLEMENTATIONS[5]: "c7_contract_and_registry_failure_family_projection",
        BOUND_IMPLEMENTATIONS[6]: "closed_failure_registry",
        BOUND_IMPLEMENTATIONS[7]: "c7_family_config",
        BOUND_IMPLEMENTATIONS[8]: "shared_family_generator",
        BOUND_IMPLEMENTATIONS[9]: "predecessor_evidence_generator",
        BOUND_IMPLEMENTATIONS[10]: "additive_rebind_generator",
    }
    for relative in BOUND_IMPLEMENTATIONS:
        by_path[relative] = _fragment_binding(root, relative, roles[relative])
    fragment["implementation_bindings"] = [
        by_path[path] for path in sorted(by_path)
    ]
    fragment["content_digest"] = _content_digest(fragment)
    return fragment


def _build_documents(root: Path) -> dict[Path, bytes]:
    _guard_predecessors(root)
    fragment = _build_fragment(root)
    fragment_payload = _canonical_json(fragment) + b"\n"

    bound_sources: set[str] = {
        item["path"]
        for group in ("source_bindings", "implementation_bindings")
        for item in fragment[group]
    }
    bound_sources.update(path.as_posix() for path in FROZEN_PREDECESSORS)
    bound_tests: set[str] = {
        item["path"] for item in fragment["test_bindings"]
    }
    bound_tests.update(EXTRA_WITNESS_TESTS)

    manifest: dict[str, Any] = {
        "schema": MANIFEST_SCHEMA,
        "family": "C7",
        "amendment": AMENDMENT,
        "fragments": [
            {
                "path": FRAGMENT_REL.as_posix(),
                "file_sha256": _sha256(fragment_payload),
                "content_digest": fragment["content_digest"],
            }
        ],
        "sources": [_raw_ref(root, path) for path in sorted(bound_sources)],
        "tests": [_raw_ref(root, path) for path in sorted(bound_tests)],
    }
    manifest_payload = _canonical_json(manifest) + b"\n"
    return {
        FRAGMENT_REL: fragment_payload,
        MANIFEST_REL: manifest_payload,
    }


def _write_atomic(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file() and path.read_bytes() == payload:
        return
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", type=Path, default=REPO_ROOT)
    parser.add_argument("--write", action="store_true")
    args = parser.parse_args(argv)
    root = args.repo_root.expanduser().resolve()
    try:
        documents = _build_documents(root)
    except (GenerationError, OSError, TypeError, ValueError, KeyError) as exc:
        print(f"INVALID: {exc}")
        return 2

    drift = [
        relative.as_posix()
        for relative, payload in documents.items()
        if not (root / relative).is_file() or (root / relative).read_bytes() != payload
    ]
    if not args.write:
        print(json.dumps({"paths": drift, "status": "DRIFT" if drift else "CHECK_OK"}, sort_keys=True))
        return 1 if drift else 0
    for relative, payload in documents.items():
        _write_atomic(root / relative, payload)
    print(json.dumps({"paths": [path.as_posix() for path in documents], "status": "WROTE"}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
