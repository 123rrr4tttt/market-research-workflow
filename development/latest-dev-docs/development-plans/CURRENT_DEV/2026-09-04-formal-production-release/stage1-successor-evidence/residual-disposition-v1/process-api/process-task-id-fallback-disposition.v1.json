  "behavioral_analysis": {
    "query_default": "get_task_info(task_id) is a direct Python call; FastAPI Query(None, ...) is not injected, so omitted project_key is None. HTTP requests receive the same None default through dependency resolution.",
    "overlay": "_db_job_to_runtime_task_info first builds task_info with task_id=db-job-7, then returns {**task_info, **runtime_projection}; runtime_projection is later and therefore its task_id=None overwrites the canonical value.",
    "logs_fallback": "get_task_logs uses the requested endpoint task_id directly in its DB summary and returns db-job-7; it does not consume runtime_projection.",
    "before_observation": {
      "projection_task_id": null,
      "info_task_id": null,
      "logs_task_id": "db-job-7",
      "classification": "OBSERVABLE_PRODUCTION_DEFECT"
    },
    "after_observation": {
      "projection_task_id": "db-job-7",
      "info_task_id": "db-job-7",
      "logs_task_id": "db-job-7",
      "explicit_payload_task_id": "provider-task-9",
      "classification": "PROPOSED_BEHAVIOR_ONLY"
    },
    "isolated_test_sufficiency": false,
    "production_effect": "The defect is externally observable through GET /api/v1/process/{task_id}: info returns task_id=null while the paired logs fallback returns db-job-7. An isolated test-only fixture change would weaken the missing-metadata regression claim."
  },
