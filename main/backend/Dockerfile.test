FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/mrw/src

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    postgresql-client \
    patch \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY ./main/backend/requirements.txt /app/requirements.txt
COPY ./pyproject.toml /opt/mrw/pyproject.toml
RUN pip install -r /app/requirements.txt \
    && python -c 'import subprocess, tomllib; from pathlib import Path; deps = tomllib.loads(Path("/opt/mrw/pyproject.toml").read_text())["project"]["optional-dependencies"]["dev"]; subprocess.check_call(["python", "-m", "pip", "install", *deps])'

COPY ./src /opt/mrw/src
COPY ./main/backend /app

ENTRYPOINT ["python", "-m", "pytest", "-q"]
