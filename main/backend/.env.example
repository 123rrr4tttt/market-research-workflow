# =============================================================================
# Environment template for 信息收集工作流
# Copy to .env and fill in your values. Never commit .env.
#   cp .env.example .env
# =============================================================================

# --- Core services (defaults work with docker-compose) ---
# DATABASE_URL: Docker 模式默认 postgres:postgres。本地 Homebrew PostgreSQL 若无 postgres 用户，
# start-local.sh 会尝试自动创建；或改为当前系统用户，如 postgresql+psycopg2://你的用户名@localhost:5432/postgres
DATABASE_URL='postgresql+psycopg2://postgres:postgres@localhost:5432/postgres'
DB_POOL_SIZE='10'
DB_POOL_MAX_OVERFLOW='5'
DB_POOL_TIMEOUT_SECONDS='5'
DB_POOL_RECYCLE_SECONDS='3600'
DB_POOL_PRE_PING='true'
DB_POOL_ECHO='false'
DB_CONNECT_TIMEOUT_SECONDS='2'
DB_STATEMENT_TIMEOUT_MS='30000'
DB_LOCK_TIMEOUT_MS='5000'
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS='120000'
DB_TRANSACTION_ISOLATION_LEVEL='read committed'
DB_TRANSACTION_RETRY_ATTEMPTS='2'
DB_TRANSACTION_RETRY_BASE_BACKOFF_MS='120'
DB_TRANSACTION_RETRY_MAX_BACKOFF_MS='1500'
ES_URL='http://localhost:9200'
REDIS_URL='redis://localhost:6379/0'
CELERY_LOG_LEVEL='info'
CELERY_CONCURRENCY='3'
CELERY_PREFETCH_MULTIPLIER='2'
CELERY_MAX_TASKS_PER_CHILD='100'
CELERY_MAX_MEMORY_PER_CHILD='500000'
CELERY_QUEUES='celery'
GRAPH_STRUCTURED_ASYNC_DISPATCH_WORKERS='4'
ACTIVE_PROJECT_KEY='default'
PROJECT_KEY_ENFORCEMENT_MODE='warn'
PROJECT_KEY_REQUIRE_IN_NON_DEV='true'

# --- LLM (optional, for extraction/search) ---
LLM_PROVIDER='openai'
OPENAI_API_KEY=''
OPENAI_API_BASE='https://api.openai.com/v1'

# Azure OpenAI (optional)
AZURE_API_KEY=''
AZURE_API_BASE=''
AZURE_API_VERSION='2024-06-01'
AZURE_CHAT_DEPLOYMENT=''
AZURE_EMBEDDING_DEPLOYMENT=''

# Ollama (optional, local)
OLLAMA_BASE_URL='http://localhost:11434'

# --- Search APIs (optional, for web/social discovery) ---
SERPAPI_KEY=''
BING_SEARCH_KEY=''
SERPSTACK_KEY=''
SERPER_API_KEY=''
AZURE_SEARCH_ENDPOINT=''
AZURE_SEARCH_KEY=''
GOOGLE_SEARCH_API_KEY=''
GOOGLE_SEARCH_CSE_ID=''
GOOGLE_APPLICATION_CREDENTIALS=''

# --- Codex Auth (optional, for browser/agent auth jump) ---
CODEX_OAUTH_ENABLED='true'
CODEX_OAUTH_REDIRECT_URI='http://localhost:8000/api/v1/codex-auth/callback'
CODEX_OAUTH_FRONTEND_SUCCESS_URL='http://localhost:5173'
CODEX_OAUTH_FRONTEND_ERROR_URL='http://localhost:5173'

# Optional local search/index enhancements. These are inactive unless selected
# in the launcher or started with --with-searxng/--with-yacy/--with-lancedb.
SEARXNG_BASE_URL='http://127.0.0.1:8088'
SEARXNG_MAX_PAGES='3'
YACY_BASE_URL='http://127.0.0.1:8090'
YACY_RESOURCE_MODE='local'

# --- Social (optional) ---
TWITTER_API_KEY=''
TWITTER_API_SECRET=''
TWITTER_BEARER_TOKEN=''
TWITTER_ACCESS_TOKEN=''
TWITTER_ACCESS_TOKEN_SECRET=''
