server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  resolver 127.0.0.11 ipv6=off valid=10s;

  location / {
    try_files $uri /index.html;
  }

  location /api/ {
    proxy_set_header X-MRW-Server-API-Key "";
    set $backend_upstream http://backend:8000;
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # The local gateway, not the browser, authenticates this one WebUI session
  # exchange. Never accept this header from the incoming request.
  location = /api/v1/codex-auth/webui/bootstrap {
    set $backend_upstream http://backend:8000;
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-MRW-Server-API-Key "__MRW_SERVER_API_KEY__";
  }

  # Embedded callers authenticate through the MRW backend exchange. The public
  # gateway must not expose WebUI's standalone loopback bootstrap endpoint.
  location = /codex/api/auth/bootstrap {
    add_header Cache-Control "no-store" always;
    return 401;
  }

  location /codex/ {
    set $webui_upstream http://__MRW_WEBUI_UPSTREAM__;
    rewrite ^/codex(/.*)$ $1 break;
    proxy_pass $webui_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /codex;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'" always;
  }

  location /codex/assets/ {
    set $webui_upstream http://__MRW_WEBUI_UPSTREAM__;
    rewrite ^/codex(/.*)$ $1 break;
    proxy_pass $webui_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    add_header Cache-Control "no-store" always;
  }

  location /codex/socket.io/ {
    set $webui_upstream http://__MRW_WEBUI_UPSTREAM__;
    rewrite ^/codex(/.*)$ $1 break;
    proxy_pass $webui_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /codex;
    proxy_read_timeout 1d;
    proxy_send_timeout 1d;
  }

}
