# Copy to main/ops/.env.local-user. Keep this file private; it is ignored by Git.
# Generate two different values containing only letters, digits, _ or -:
#   openssl rand -hex 32
MRW_SERVER_API_KEY=replace-with-a-random-server-key
MRW_WEBUI_API_KEY=replace-with-a-different-random-webui-key

# Loopback ports. Change only if another local service uses the defaults.
MRW_DOCKER_PORT=15132
MRW_DOCKER_API_PORT=18132

# Optional outbound proxy for Docker on hosts that require one. Leave empty
# unless the selected network needs it. Docker Desktop can reach the host at
# host.docker.internal.
MRW_HTTP_PROXY=
MRW_HTTPS_PROXY=
